# Copy to /etc/workhive/backup.env on the EC2 host.
# This file contains placeholders only and must not contain AWS access keys.
BACKUP_BUCKET=replace-with-private-backup-bucket-name
AWS_REGION=eu-west-1
S3_PREFIX=production
WORKHIVE_DIR=/home/ubuntu/workhive
COMPOSE_FILE=/home/ubuntu/workhive/docker-compose.yml
COMPOSE_ENV_FILE=/home/ubuntu/workhive/.env
LOCAL_BACKUP_ROOT=/home/ubuntu/workhive-backups
LOCAL_RETENTION_DAYS=8
