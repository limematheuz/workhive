# Private host configuration for the manual ECR deployment command.
# Copy this to /etc/workhive/deploy.env on EC2. Do not commit the real file.

WORKHIVE_DIR=/home/ubuntu/workhive
COMPOSE_ENV_FILE=/home/ubuntu/workhive/.env
AWS_REGION=eu-west-1

# The instance role already authenticates to ECR. Do not add AWS access keys.
AWS_BIN=/snap/bin/aws
