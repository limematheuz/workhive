{
  "name": "workhive-release-tools",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "clean:cache": "node scripts/clean-caches.mjs",
    "test:clean:cache": "node --test scripts/clean-caches.test.mjs",
    "test:architecture": "node --test scripts/architecture-guardrails.test.mjs",
    "release:prepare": "node scripts/release-version.mjs",
    "release:verify": "node scripts/release-version.mjs --verify",
    "release:tag": "node scripts/release-tag.mjs",
    "test:release": "node --test scripts/release-version.test.mjs scripts/release-tag.test.mjs"
  }
}
