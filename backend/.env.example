PROJECT_NAME=WorkHive Enterprise
APP_VERSION=1.1.1
GIT_SHA=unknown
API_V1_STR=/api/v1

# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:replace-with-a-local-password@localhost:5432/workhive_db
MIGRATION_DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_USE_NULL_POOL=

# ─── Seguridad ────────────────────────────────────────────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Entorno ──────────────────────────────────────────────────────────────────
ALLOW_PUBLIC_REGISTRATION=false
ENVIRONMENT=development
# En producción: ENVIRONMENT=production

# ─── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

CORS_ORIGINS=http://localhost:3000

TRUSTED_HOSTS=localhost,127.0.0.1,testserver

FORCE_HTTPS=false
# En producción: FORCE_HTTPS=true

# Cookie domain for shared subdomains (optional). Example: .workhive.app
SESSION_COOKIE_DOMAIN=

# Optional shared secret for detailed /health/ready checks.
# Without it, /health/ready still works but omits component details.
HEALTH_READY_TOKEN=

# ─── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
RUN_CALENDAR_BACKGROUND_SYNC=false
# En producción: LOG_JSON=true

# ─── SMTP (opcional, necesario para envío de emails) ─────────────────────────
EMAIL_ENABLED=false
CONTACT_FORM_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
CONTACT_RECIPIENT_EMAIL=
INVOICE_EMAIL_RATE_LIMIT=10

# ─── Stripe / Facturación ─────────────────────────────────────────────────────
SUBSCRIPTION_ENFORCEMENT_ENABLED=false
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# ─── Verifactu (desactivado hasta tener certificado real) ────────────────────
VERIFACTU_ENABLED=false
VERIFACTU_ENVIRONMENT=test
VERIFACTU_AUTO_SUBMIT=false
VERIFACTU_CERTIFICATE_PATH=
VERIFACTU_CERTIFICATE_PASSWORD=
VERIFACTU_SOFTWARE_PRODUCER_NAME=
VERIFACTU_SOFTWARE_PRODUCER_TAX_ID=
VERIFACTU_SOFTWARE_ID=WH
VERIFACTU_INSTALLATION_ID=1
VERIFACTU_TIMEOUT_SECONDS=30
VERIFACTU_MAX_RETRIES=8

# ─── Almacenamiento ───────────────────────────────────────────────────────────
# En producción usar "s3" + configurar S3_BUCKET, S3_REGION, etc.
INVOICE_PDF_STORAGE_PATH=storage/invoices
ELECTRONIC_INVOICE_STORAGE_PATH=storage/electronic-invoices
FISCAL_CERTIFICATE_STORAGE_PATH=storage/fiscal-certificates
MEDIA_STORAGE_BACKEND=local
MEDIA_STORAGE_PATH=storage/media
S3_ENDPOINT_URL=
S3_REGION=eu-west-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

FACTURAE_CERTIFICATE_PATH=
FACTURAE_CERTIFICATE_PASSWORD=

# ─── Google Calendar OAuth ────────────────────────────────────────────────────
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar/google/callback
GOOGLE_CALENDAR_TIMEZONE=Europe/Madrid
GOOGLE_CALENDAR_BACKGROUND_SYNC_INTERVAL_SECONDS=300
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ─── GDPR ─────────────────────────────────────────────────────────────────────
PRIVACY_POLICY_VERSION=2026-06-15
AUDIT_IP_RETENTION_DAYS=90
DATA_SUBJECT_REQUEST_RETENTION_DAYS=1095

# ─── Backups ──────────────────────────────────────────────────────────────────
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# ─── Docker ───────────────────────────────────────────────────────────────────
# PORT=8000
# WEB_CONCURRENCY=2
