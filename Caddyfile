{$APP_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		# Keep oversized request bodies out of the application process. Individual
		# endpoints enforce tighter limits for images and certificates.
		request_body {
			max_size 6MB
		}
		reverse_proxy backend:8000
	}

	handle /health* {
		reverse_proxy backend:8000
	}

	handle /uploads/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
