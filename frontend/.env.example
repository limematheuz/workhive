# Desarrollo local. En producción Caddy publica frontend y API en el mismo dominio.
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=

# Metadatos públicos del build. Producción los inyecta desde la versión y commit.
NEXT_PUBLIC_APP_VERSION=1.5.1
NEXT_PUBLIC_GIT_SHA=unknown

# Habilita el acceso de pruebas a Stripe Checkout. Solo debe ser true cuando
# el backend usa claves y precios del mismo entorno de Stripe.
NEXT_PUBLIC_BILLING_CHECKOUT_ENABLED=false

# ─── Datos de contacto (se muestran en la app) ───────────────────────────────
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_BUSINESS_LOCATION=
