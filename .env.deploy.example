# Copia este archivo como .env.deploy SOLO en el servidor.
# No guardes .env.deploy en GitHub.

# ─── Dominio ────────────────────────────────────────────────────────────────
# Dominio público apuntando a la IP de EC2, sin https:// ni barra final.
APP_DOMAIN=app.example.com

# Datos públicos mostrados en /contact. No son secretos.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_BUSINESS_LOCATION=

# ─── Base de datos privada dentro de Docker ────────────────────────────────
POSTGRES_USER=workhive
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=workhive_db

# Genera con: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Runtime ───────────────────────────────────────────────────────────────
APP_VERSION=1.1.0
GIT_SHA=unknown
WEB_CONCURRENCY=1
ALLOW_PUBLIC_REGISTRATION=false

# Cookie domain: leave empty for sslip.io / single-host deploys.
# Use .yourdomain.com only if frontend and API are on different subdomains.
SESSION_COOKIE_DOMAIN=

# Optional: detailed /health/ready checks (header X-WorkHive-Ready-Token).
HEALTH_READY_TOKEN=

# ─── Email / contacto ──────────────────────────────────────────────────────
EMAIL_ENABLED=false
CONTACT_FORM_ENABLED=false
# Para Gmail usa smtp.gmail.com:587 y una contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
CONTACT_RECIPIENT_EMAIL=

# ─── Google Calendar OAuth ─────────────────────────────────────────────────
# Con sslip.io solo funciona con Test users. Para producción pública usa dominio propio.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://app.example.com/api/v1/calendar/google/callback
GOOGLE_CALENDAR_TIMEZONE=Europe/Madrid
GOOGLE_CALENDAR_BACKGROUND_SYNC_INTERVAL_SECONDS=300
RUN_CALENDAR_BACKGROUND_SYNC=false
# Genera con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ─── Stripe ────────────────────────────────────────────────────────────────
BILLING_ENABLED=false
SUBSCRIPTION_ENFORCEMENT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# ─── VERI*FACTU / Facturae ─────────────────────────────────────────────────
VERIFACTU_ENABLED=false
VERIFACTU_ENVIRONMENT=test
VERIFACTU_AUTO_SUBMIT=false
VERIFACTU_CERTIFICATE_PATH=
VERIFACTU_CERTIFICATE_PASSWORD=
VERIFACTU_SOFTWARE_PRODUCER_NAME=
VERIFACTU_SOFTWARE_PRODUCER_TAX_ID=
VERIFACTU_SOFTWARE_ID=WH
VERIFACTU_INSTALLATION_ID=1
VERIFACTU_TIMEOUT_SECONDS=30
VERIFACTU_MAX_RETRIES=8
FACTURAE_CERTIFICATE_PATH=
FACTURAE_CERTIFICATE_PASSWORD=

# ─── Almacenamiento ────────────────────────────────────────────────────────
# local: usa el volumen Docker appdata. s3: requiere bucket y credenciales.
MEDIA_STORAGE_BACKEND=local
MEDIA_STORAGE_PATH=/data/media
INVOICE_PDF_STORAGE_PATH=/data/invoices
ELECTRONIC_INVOICE_STORAGE_PATH=/data/electronic-invoices
FISCAL_CERTIFICATE_STORAGE_PATH=/data/fiscal-certificates
S3_ENDPOINT_URL=
S3_REGION=eu-west-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
